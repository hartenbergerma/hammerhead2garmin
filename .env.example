# Copy this file to .env and fill in your credentials.
# .env is gitignored and will never be committed.

HAMMERHEAD_CLIENT_ID=your_client_id
HAMMERHEAD_CLIENT_SECRET=your_client_secret
HAMMERHEAD_USERNAME=your@email.com
HAMMERHEAD_PASSWORD=your_hammerhead_password

GARMIN_USERNAME=your@email.com
GARMIN_PASSWORD=your_garmin_password

# Optional: only sync activities on or after this date (used on first run when
# there is no sync state yet). Format: YYYY-MM-DD. Leave unset to sync everything.
# SYNC_FROM_DATE=2026-06-07

# Optional: override default file paths
# SYNC_STATE_FILE=sync_state.json
# DATA_DIR=data
